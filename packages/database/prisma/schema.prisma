generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  SYSTEM
  MILITARY
  PERSIT
}

enum ProfileType {
  MILITARY
  PERSIT
}

enum AttendanceEventType {
  EXIT
  RETURN
}

enum AttendanceSessionStatus {
  OPEN
  CLOSED
}

enum PresenceValidationStatus {
  PENDING
  VALID
  REJECTED
  REVIEW_REQUIRED
}

enum CheckpointStatus {
  ACTIVE
  INACTIVE
}

enum QrStatus {
  ACTIVE
  REVOKED
}

enum UserPermissionEffect {
  ALLOW
  DENY
}

model User {
  id                String                   @id @default(uuid()) @db.Uuid
  username          String                   @unique @db.VarChar(100)
  pinHash           String                   @map("pin_hash") @db.VarChar(255)
  accountType       AccountType              @map("account_type")
  isActive          Boolean                  @default(true) @map("is_active")
  isVerified        Boolean                  @default(false) @map("is_verified")
  lastLoginAt       DateTime?                @map("last_login_at") @db.Timestamptz(6)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?                @map("deleted_at") @db.Timestamptz(6)
  sessions          UserSession[]
  devices           UserDevice[]
  roles             UserRole[]
  directPermissions UserPermission[]
  militaryProfile   MilitaryPersonnel?
  persitProfile     PersitMember?
  organizationAssignments OrganizationAssignment[]
  attendanceSessions AttendanceSession[]
  attendanceEvents  AttendanceEvent[]
  securityEvents    SecurityEvent[]
  createdQrs        CheckpointQr[]           @relation("QrCreator")
  createdPolicies   AttendancePolicy[]       @relation("PolicyCreator")

  @@map("users")
}

model UserSession {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  refreshTokenHash  String    @unique @map("refresh_token_hash") @db.VarChar(255)
  deviceId          String?   @map("device_id") @db.VarChar(255)
  ipAddress         String?   @map("ip_address") @db.VarChar(45)
  userAgent         String?   @map("user_agent") @db.Text
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user              User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@map("user_sessions")
}

model UserDevice {
  id                 String            @id @default(uuid()) @db.Uuid
  userId             String            @map("user_id") @db.Uuid
  deviceFingerprint  String            @map("device_fingerprint") @db.VarChar(255)
  deviceName         String?           @map("device_name") @db.VarChar(255)
  platform           String?           @db.VarChar(100)
  isTrusted          Boolean           @default(false) @map("is_trusted")
  isActive           Boolean           @default(true) @map("is_active")
  lastSeenAt         DateTime?         @map("last_seen_at") @db.Timestamptz(6)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  user               User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  attendanceEvents   AttendanceEvent[]

  @@unique([userId, deviceFingerprint])
  @@map("user_devices")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(100)
  name        String           @db.VarChar(150)
  description String?          @db.Text
  isSystem    Boolean          @default(false) @map("is_system")
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  users       UserRole[]
  permissions RolePermission[]
  scopes      RoleScope[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(150)
  module      String           @db.VarChar(100)
  action      String           @db.VarChar(100)
  description String?          @db.Text
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  roles       RolePermission[]
  users       UserPermission[]

  @@map("permissions")
}

model UserRole {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  roleId     String    @map("role_id") @db.Uuid
  assignedBy String?   @map("assigned_by") @db.Uuid
  assignedAt DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  isActive   Boolean   @default(true) @map("is_active")
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([userId, isActive])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserPermission {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @map("user_id") @db.Uuid
  permissionId String              @map("permission_id") @db.Uuid
  effect       UserPermissionEffect
  assignedBy   String?             @map("assigned_by") @db.Uuid
  expiresAt    DateTime?           @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  permission   Permission          @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([userId, permissionId])
  @@map("user_permissions")
}

model RoleScope {
  id             String       @id @default(uuid()) @db.Uuid
  roleId         String       @map("role_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  scopeType      String       @map("scope_type") @db.VarChar(30)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([roleId, organizationId, scopeType])
  @@map("role_scopes")
}

model Organization {
  id              String                   @id @default(uuid()) @db.Uuid
  parentId        String?                  @map("parent_id") @db.Uuid
  code            String                   @unique @db.VarChar(100)
  name            String                   @db.VarChar(200)
  organizationType String                  @map("organization_type") @db.VarChar(100)
  isActive        Boolean                  @default(true) @map("is_active")
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  parent          Organization?            @relation("OrganizationTree", fields: [parentId], references: [id], onDelete: Restrict)
  children        Organization[]           @relation("OrganizationTree")
  units           Unit[]
  barracks        Barracks[]
  assignments     OrganizationAssignment[]
  roleScopes      RoleScope[]
  checkpoints     Checkpoint[]
  policies        AttendancePolicy[]

  @@map("organizations")
}

model Unit {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  code           String                   @unique @db.VarChar(100)
  name           String                   @db.VarChar(200)
  isActive       Boolean                  @default(true) @map("is_active")
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  barracks       Barracks[]
  assignments    OrganizationAssignment[]
  policies       AttendancePolicy[]

  @@map("units")
}

model Barracks {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  unitId         String?                  @map("unit_id") @db.Uuid
  code           String                   @unique @db.VarChar(100)
  name           String                   @db.VarChar(200)
  isActive       Boolean                  @default(true) @map("is_active")
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  unit           Unit?                    @relation(fields: [unitId], references: [id], onDelete: Restrict)
  assignments    OrganizationAssignment[]

  @@map("barracks")
}

model OrganizationAssignment {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  unitId         String?      @map("unit_id") @db.Uuid
  barracksId     String?      @map("barracks_id") @db.Uuid
  isPrimary      Boolean      @default(false) @map("is_primary")
  startDate      DateTime     @map("start_date") @db.Date
  endDate        DateTime?    @map("end_date") @db.Date
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  unit           Unit?        @relation(fields: [unitId], references: [id], onDelete: Restrict)
  barracks       Barracks?    @relation(fields: [barracksId], references: [id], onDelete: Restrict)

  @@index([userId, startDate, endDate])
  @@map("organization_assignments")
}

model MilitaryPersonnel {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  nrp              String   @unique @db.VarChar(50)
  fullName         String   @map("full_name") @db.VarChar(200)
  rank             String?  @db.VarChar(100)
  position         String?  @db.VarChar(150)
  personnelStatus  String   @map("personnel_status") @db.VarChar(30)
  joinDate         DateTime? @map("join_date") @db.Date
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user             User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  familyRelations  FamilyRelationship[]

  @@map("military_personnel")
}

model PersitMember {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid
  memberNumber       String   @unique @map("member_number") @db.VarChar(50)
  fullName           String   @map("full_name") @db.VarChar(200)
  membershipStatus   String   @map("membership_status") @db.VarChar(30)
  joinDate           DateTime? @map("join_date") @db.Date
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user               User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  familyRelations    FamilyRelationship[]

  @@map("persit_members")
}

model FamilyRelationship {
  id                 String           @id @default(uuid()) @db.Uuid
  militaryId         String           @map("military_id") @db.Uuid
  persitId           String           @map("persit_id") @db.Uuid
  relationshipType   String           @map("relationship_type") @db.VarChar(50)
  verificationStatus String           @map("verification_status") @db.VarChar(30)
  verifiedBy         String?          @map("verified_by") @db.Uuid
  verifiedAt         DateTime?        @map("verified_at") @db.Timestamptz(6)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  military           MilitaryPersonnel @relation(fields: [militaryId], references: [id], onDelete: Restrict)
  persit             PersitMember     @relation(fields: [persitId], references: [id], onDelete: Restrict)

  @@unique([militaryId, persitId])
  @@map("family_relationships")
}

model Checkpoint {
  id                    String          @id @default(uuid()) @db.Uuid
  organizationId        String          @map("organization_id") @db.Uuid
  code                  String          @unique @db.VarChar(100)
  name                  String          @db.VarChar(200)
  description           String?         @db.Text
  latitude              Decimal         @db.Decimal(10, 7)
  longitude             Decimal         @db.Decimal(10, 7)
  radiusMeter           Decimal         @map("radius_meter") @db.Decimal(10, 2)
  accuracyLimitMeter    Decimal         @map("accuracy_limit_meter") @db.Decimal(10, 2)
  status                CheckpointStatus @default(ACTIVE)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  qrs                   CheckpointQr[]
  attendanceEvents      AttendanceEvent[]

  @@index([organizationId, status])
  @@map("checkpoints")
}

model CheckpointQr {
  id          String    @id @default(uuid()) @db.Uuid
  checkpointId String   @map("checkpoint_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.VarChar(255)
  version     Int
  status      QrStatus  @default(ACTIVE)
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  checkpoint  Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Restrict)
  creator     User      @relation("QrCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([checkpointId, status])
  @@map("checkpoint_qrs")
}

model AttendancePolicy {
  id                    String          @id @default(uuid()) @db.Uuid
  organizationId        String?         @map("organization_id") @db.Uuid
  unitId                String?         @map("unit_id") @db.Uuid
  profileType           ProfileType?    @map("profile_type")
  name                  String          @db.VarChar(150)
  overdueAfterMinutes   Int             @map("overdue_after_minutes")
  isActive              Boolean         @default(true) @map("is_active")
  effectiveFrom         DateTime        @map("effective_from") @db.Timestamptz(6)
  effectiveUntil        DateTime?       @map("effective_until") @db.Timestamptz(6)
  createdBy             String          @map("created_by") @db.Uuid
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization          Organization?   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  unit                  Unit?           @relation(fields: [unitId], references: [id], onDelete: Restrict)
  creator               User            @relation("PolicyCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  sessions              AttendanceSession[]

  @@index([organizationId, unitId, profileType, isActive])
  @@map("attendance_policies")
}

model AttendanceSession {
  id                 String                   @id @default(uuid()) @db.Uuid
  userId             String                   @map("user_id") @db.Uuid
  profileType        ProfileType              @map("profile_type")
  exitAt             DateTime                 @map("exit_at") @db.Timestamptz(6)
  returnAt           DateTime?                @map("return_at") @db.Timestamptz(6)
  status             AttendanceSessionStatus
  attendancePolicyId String?                  @map("attendance_policy_id") @db.Uuid
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  user               User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  policy             AttendancePolicy?        @relation(fields: [attendancePolicyId], references: [id], onDelete: Restrict)
  events             AttendanceEvent[]

  @@index([userId, exitAt(sort: Desc)])
  @@map("attendance_sessions")
}

model AttendanceEvent {
  id                String                    @id @default(uuid()) @db.Uuid
  userId            String                    @map("user_id") @db.Uuid
  sessionId         String                    @map("session_id") @db.Uuid
  checkpointId      String                    @map("checkpoint_id") @db.Uuid
  deviceId          String?                   @map("device_id") @db.Uuid
  profileType       ProfileType               @map("profile_type")
  eventType         AttendanceEventType       @map("event_type")
  validationStatus  PresenceValidationStatus  @map("validation_status")
  recordedAt        DateTime                  @map("recorded_at") @db.Timestamptz(6)
  latitude          Decimal                   @db.Decimal(10, 7)
  longitude         Decimal                   @db.Decimal(10, 7)
  accuracy          Decimal                   @db.Decimal(10, 2)
  distanceMeter     Decimal?                  @map("distance_meter") @db.Decimal(10, 2)
  idempotencyKey    String                    @unique @map("idempotency_key") @db.VarChar(150)
  riskMetadata      Json?                     @map("risk_metadata") @db.JsonB
  metadata          Json?                     @db.JsonB
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  user              User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  session           AttendanceSession         @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  checkpoint        Checkpoint                @relation(fields: [checkpointId], references: [id], onDelete: Restrict)
  device            UserDevice?               @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@index([userId, recordedAt(sort: Desc)])
  @@index([checkpointId, recordedAt(sort: Desc)])
  @@map("attendance_events")
}

model SecurityEvent {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String?   @map("user_id") @db.Uuid
  eventType         String    @map("event_type") @db.VarChar(100)
  severity          String    @db.VarChar(20)
  source            String    @db.VarChar(100)
  metadata          Json?     @db.JsonB
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user              User?     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([severity, createdAt(sort: Desc)])
  @@map("security_events")
}